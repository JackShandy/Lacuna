# game/script.rpy:13284
translate Chinese resetGame_e0648967:

  # "{color=#ffffff}You have come to a dark place.{/color}"
  "{color=#ffffff}你来到了一处黑暗之地。{/color}"

# game/script.rpy:13285
translate Chinese resetGame_3ebfa092:

  # "{color=#ffffff}A gap in the manuscript.{/color}"
  "{color=#ffffff}手稿中的一处空白。{/color}"

# game/script.rpy:13286
translate Chinese resetGame_bc67556f:

  # "{color=#ffffff}Here, you can wipe everything away, and start again from the beginning.{/color}"
  "{color=#ffffff}在这里，你可以抹去一切，从头开始。{/color}"

# game/script.rpy:13287
translate Chinese resetGame_78c5079c:

  # "{color=#ffffff}Like it never happened at all.{/color}"
  "{color=#ffffff}就当这一切从未发生过。{/color}"

# game/script.rpy:13288
translate Chinese resetGame_0fe0f4aa:

  # "{color=#ffffff}Are you sure you want to do this?{/color}"
  "{color=#ffffff}你确定要这么做吗？{/color}"

# game/script.rpy:13295
translate Chinese resetGame_7e6080f9:

  # "{color=#ffffff}Very well.{/color}"
  "{color=#ffffff}很好。{/color}"

# game/script.rpy:13296
translate Chinese resetGame_13f27258:

  # "{color=#ffffff}Goodbye, for now.{/color}"
  "{color=#ffffff}那么，再见了。{/color}"

# game/script.rpy:13301
translate Chinese resetGame_7e6080f9_1:

  # "{color=#ffffff}Very well.{/color}"
  "{color=#ffffff}很好。{/color}"

# game/script.rpy:13302
translate Chinese resetGame_8caa7a1b:

  # "{color=#ffffff}Stay here a little longer.{/color}"
  "{color=#ffffff}在这里再待一会儿吧。{/color}"

