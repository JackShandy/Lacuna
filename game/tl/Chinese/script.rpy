# game/script.rpy:2154
translate Chinese devilYes_7b1aab3f:

  # mum "Then I don't want you as the Godfather. You lie, and cheat, and lead good people astray."
  mum "那么我不要你做教父。你撒谎、欺骗，还将好人引入歧途。"

# game/script.rpy:2155
translate Chinese devilYes_2977bb76:

  # "She turned away from him, and raced deeper into the forest."
  "她转过身，向森林更深处跑去。"

# game/script.rpy:2158
translate Chinese devilYes_ec056025:

  # mir "Why, I am the Devil Himself."
  mir "怎么，我可是魔鬼本尊。"

# game/script.rpy:2163
translate Chinese thirdMan1_e22642e2:

  # "In the deepest darkness of the forest, she may or may not have met a handsome woman all in black."
  "在森林最深处的幽暗中，她也许遇见了一个英气逼人的黑衣女子，也许未曾遇见。"

# game/script.rpy:2164
translate Chinese thirdMan1_1d4a7d85:

  # "(What can any of us know for certain, except that the mercies of the Almighty are vaster than the deepest ocean and more numerous than all the pebbles on the land?)"
  "（全能者的仁慈深过极渊，多过世间所有砾石，除了这等真理，我们还能对什么确信无疑呢？）"

# game/script.rpy:2165
translate Chinese thirdMan1_cdd9b922:

  # "Her limbs were broken. She had no hands."
  "她四肢俱断。她没有双手。"

# game/script.rpy:2166
translate Chinese thirdMan1_506f4703:

  # wib "Poor woman. Let me be the Godmother."
  wib "可怜的女人。让我来做这孩子的教母吧。"

# game/script.rpy:2167
translate Chinese thirdMan1_3d60a888:

  # wib "The child will have nothing. [He] will need nothing."
  wib "这孩子将一无所有。[He]也将一无所求。"

# game/script.rpy:2174
translate Chinese thirdMan2_4fb461a1:

  # wib "[He] need make no promises. I have no demands." nointeract
  wib "[He]无需做出任何承诺。我没有任何要求。" nointeract

# game/script.rpy:2176
translate Chinese thirdMan2_6b7d28b9:

  # mum "You're just the right one. You take rich and poor without distinction."
  mum "您正是最合适的人选。无论是贫是富，您都一视同仁地带走。"

# game/script.rpy:2177
translate Chinese thirdMan2_307d657e:

  # wib "You did not have a choice."
  wib "你别无选择。"

# game/script.rpy:2179
translate Chinese deathYes_558f8670:

  # "In one swoop She bowed down and placed Her mark upon you."
  "她猛然俯下身，在你身上烙下她的印记。"

# game/script.rpy:2180
translate Chinese deathYes_0c6c5d7e:

  # wib "You will name [him] [povname]."
  wib "你要给[him]起名叫[povname]。"

# game/script.rpy:2182
translate Chinese deathYes_81394059:

  # wib "The moment [he] turn eighteen, [he] will be mine."
  wib "待[he]满十八岁那刻，[he]就将属于我。"

# game/script.rpy:2184
translate Chinese deathYes_a5f420c0:

  # wib "The moment [he] turns eighteen, [he] will be mine."
  wib "待[he]满十八岁那刻，[he]就将属于我。"

# game/script.rpy:2185
translate Chinese deathYes_f7258784:

  # wib "Keep [him] safe for me until I come for [him]. I will send three messengers before me to announce my arrival. "
  wib "在我来接[him]之前，替我保[him]平安。我会在现身前派去三位信使，昭告我的到来。"

# game/script.rpy:2192
